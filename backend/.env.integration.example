# For Linux/macOS, copy to .env.integration and generate different random secrets.
# Windows: scripts/start-integration.ps1 generates this automatically.
DB_PASSWORD=replace-with-random-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
STORAGE_PASSWORD=replace-with-random-local-storage-password
MINIO_PUBLIC_ENDPOINT=http://10.0.2.2:9000
