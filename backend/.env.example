# Docker Compose reads .env. For bootRun, export these values in your shell too.
DB_URL=jdbc:postgresql://localhost:5432/panenku
DB_USER=panenku
DB_PASSWORD=replace-with-local-database-password
# At least 32 UTF-8 bytes; replace locally, never commit the actual secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=panenku
SERVER_PORT=8080
JWT_EXPIRATION=86400000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-local-storage-access-key
MINIO_SECRET_KEY=replace-with-local-storage-secret-key
MINIO_BUCKET=panenku-files
# Background expiration scheduler (optional overrides)
SCHEDULER_ENABLED=true
EXPIRATION_DELAY_MS=300000
EXPIRATION_INITIAL_DELAY_MS=300000
EXPIRATION_BATCH_SIZE=100
