# Docker Compose reads .env. For bootRun, export these values in your shell too.
DB_URL=jdbc:postgresql://localhost:5432/panenku
DB_USER=panenku
DB_PASSWORD=replace-with-local-database-password
# At least 32 UTF-8 bytes; replace locally, never commit the actual secret.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=panenku
SERVER_PORT=8080
JWT_EXPIRATION=86400000
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace-with-local-storage-access-key
MINIO_SECRET_KEY=replace-with-local-storage-secret-key
MINIO_BUCKET=panenku-files
# Optional local development QRIS/payment/refund proof directory (private POSIX directory; not a web root).
PAYMENT_STORAGE_LOCAL_DIR=
# Development only: upload dummy KTP, never real identity documents.
KTP_DUMMY_ENABLED=false
# Local development only: shifts the backend business clock without changing macOS time.
# ISO-8601 duration, for example PT10H. Keep PT0S for normal local use.
PANENKU_DEV_CLOCK_OFFSET=PT0S
# Background expiration scheduler (optional overrides)
SCHEDULER_ENABLED=true
EXPIRATION_DELAY_MS=300000
EXPIRATION_INITIAL_DELAY_MS=300000
EXPIRATION_BATCH_SIZE=100

# F1: enable either local development storage below, or the product-photos Compose profile.
PRODUCT_PHOTOS_ENABLED=false
PRODUCT_PHOTOS_LOCAL_DIR=
# For a USB phone with adb reverse; emulator uses http://10.0.2.2:8080 instead.
PRODUCT_PHOTOS_LOCAL_BASE_URL=http://127.0.0.1:8080
PRODUCT_PHOTOS_BUCKET=panenku-products
# URL reachable by the Android device/emulator; use 10.0.2.2 for the host from Android emulator.
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
